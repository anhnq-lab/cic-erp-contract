# ============================================================
#  CIC ERP CONTRACT — Cấu hình môi trường
#  Sao chép file này thành .env.local và điền giá trị thật.
#  KHÔNG commit .env.local vào git.
# ============================================================

# ── Supabase (BẮT BUỘC) ─────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── AI Providers (tùy chọn — có thể cấu hình qua UI) ────────
# Gemini (Google AI Studio): https://aistudio.google.com/app/apikey
VITE_GOOGLE_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# DeepSeek: https://platform.deepseek.com/api_keys
VITE_DEEPSEEK_API_KEY=

# ── AI Nội bộ / On-prem (tùy chọn) ─────────────────────────
# LiteLLM / vLLM endpoint (không để key service ở đây)
VITE_VLLM_URL=http://localhost:4000
VITE_VLLM_GEMMA_URL=http://localhost:8002

# ── Dev Only (KHÔNG dùng trên production) ───────────────────
# Bật để auto-login khi dev local, chỉ hoạt động ở localhost
VITE_DEV_BYPASS_AUTH=false
VITE_DEV_EMAIL=appdev@cic.com.vn
VITE_DEV_PASSWORD=

# ── Telegram (tùy chọn) ─────────────────────────────────────
# Dùng cho worker cic-telegram-openclaw
# VITE_TELEGRAM_BOT_TOKEN=   ← Chỉ dùng ở server/workers, KHÔNG prefix VITE_
